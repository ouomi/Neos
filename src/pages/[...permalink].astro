---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleSidebar from '../components/ArticleSidebar.astro';
import { getSiteBasicInfo, getSiteOwner } from '../lib/site-config';
import { getPublishedArticles } from '../lib/article-catalog';
import { getHomeUrl } from '../lib/site-routes';
import '../styles/article.css';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();

  return articles.map(function (article) {
    return {
      params: { permalink: article.data.permalink },
      props: { article },
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);
const homeUrl = getHomeUrl();
const siteBasicInfo = getSiteBasicInfo();
const siteOwner = getSiteOwner();
const { title, date } = article.data;
let author = siteOwner.name;

if (article.data.author !== undefined && article.data.author !== null) {
  author = article.data.author;
}
---

<BaseLayout title={`${title} · ${siteBasicInfo.title}`}>
  <div class="article-page">
    <ArticleSidebar />
    <div class="article-main">
      <p class="back-link"><a href={homeUrl}>返回首页</a></p>

      <article class="article" data-pagefind-body>
        <header class="article-header">
          <h1 class="article-title" data-pagefind-weight="10">{title}</h1>
          <div class="article-meta" aria-label="文章信息">
            <span class="article-author">作者：{author}</span>
            <time class="article-date" datetime={date.toISOString()}>
              发布于 {date.toLocaleDateString(siteBasicInfo.language)}
            </time>
          </div>
        </header>
        <div class="article-content">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  let imageViewerPromise:
    | Promise<typeof import('../scripts/image-viewer.ts')>
    | undefined;
  let codeBlocksLoaded = false;

  function loadImageViewer() {
    if (imageViewerPromise !== undefined) {
      return imageViewerPromise;
    }

    const promise = import('../scripts/image-viewer.ts');
    imageViewerPromise = promise;

    promise.catch(function () {
      if (imageViewerPromise === promise) {
        imageViewerPromise = undefined;
      }
    });

    return promise;
  }

  function preloadImageViewer() {
    loadImageViewer().catch(function () {
    });
  }

  function getImageViewerTrigger(target: EventTarget | null) {
    if (!(target instanceof HTMLImageElement)) {
      return undefined;
    }

    if (target.matches('.article-content img.article-image-trigger') === false) {
      return undefined;
    }

    return target;
  }

  function openImageViewer(image: HTMLImageElement) {
    loadImageViewer()
      .then(function (imageViewer) {
        return imageViewer.openImageViewer(image);
      })
      .catch(function () {
      });
  }

  function prepareImageViewerTrigger(image: HTMLImageElement) {
    if (image.closest('a, button') !== null) {
      return;
    }

    image.classList.add('article-image-trigger');
    image.tabIndex = 0;
    image.setAttribute('role', 'button');

    if (image.hasAttribute('aria-label') === false) {
      const alt = image.alt.trim();
      let label = '预览图片';

      if (alt.length > 0) {
        label += '：' + alt;
      }

      image.setAttribute('aria-label', label);
    }
  }

  function prepareImageViewerTriggers() {
    document.querySelectorAll('.article-content img').forEach(function (image) {
      if (image instanceof HTMLImageElement) {
        prepareImageViewerTrigger(image);
      }
    });
  }

  function preloadImageViewerForPointer(event: PointerEvent) {
    const image = getImageViewerTrigger(event.target);

    if (image === undefined) {
      return;
    }

    preloadImageViewer();
  }

  function openImageViewerForClick(event: MouseEvent) {
    const image = getImageViewerTrigger(event.target);

    if (image === undefined || event.defaultPrevented === true) {
      return;
    }

    event.preventDefault();
    openImageViewer(image);
  }

  function openImageViewerForKeyboard(event: KeyboardEvent) {
    const image = getImageViewerTrigger(event.target);

    if (image === undefined || event.defaultPrevented === true) {
      return;
    }

    if (event.key !== 'Enter' && event.key !== ' ') {
      return;
    }

    event.preventDefault();

    if (event.repeat === true) {
      return;
    }

    openImageViewer(image);
  }

  function loadCodeBlocks() {
    if (codeBlocksLoaded === true) {
      return;
    }

    codeBlocksLoaded = true;
    import('../scripts/code-block.ts');
  }

  if (document.querySelector('.article-content img') !== null) {
    prepareImageViewerTriggers();

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(preloadImageViewer, { timeout: 3000 });
    } else {
      window.setTimeout(preloadImageViewer, 1500);
    }

    document.addEventListener('pointerdown', preloadImageViewerForPointer, {
      passive: true,
    });
    document.addEventListener('click', openImageViewerForClick);
    document.addEventListener('keydown', openImageViewerForKeyboard);
  }

  if (document.querySelector('.article-content pre.astro-code') !== null) {
    loadCodeBlocks();
  }
</script>
