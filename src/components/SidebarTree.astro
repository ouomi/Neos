---
import type { SidebarNode } from '../lib/article-catalog';
import { getArticleUrl } from '../lib/site-routes';
import SidebarTree from './SidebarTree.astro';

interface Props {
  nodes: SidebarNode[];
  currentArticleId: string;
}

const { nodes, currentArticleId } = Astro.props;
---

<ul class="sidebar-tree">
  {nodes.map(function (node) {
    if (node.type === 'directory') {
      const isCurrentBranch =
        currentArticleId === node.path || currentArticleId.startsWith(`${node.path}/`);

      return (
        <li class="sidebar-directory">
          <details open={isCurrentBranch}>
            <summary>{node.name}</summary>
            <SidebarTree nodes={node.children} currentArticleId={currentArticleId} />
          </details>
        </li>
      );
    }

    const isCurrentArticle = node.id === currentArticleId;
    const articleUrl = getArticleUrl(node.permalink);
    let currentAttribute = {};
    if (isCurrentArticle === true) {
      currentAttribute = { 'aria-current': 'page' };
    }

    return (
      <li class="sidebar-article">
        <a href={articleUrl} data-sidebar-path={articleUrl} {...currentAttribute}>{node.title}</a>
      </li>
    );
  })}
</ul>
