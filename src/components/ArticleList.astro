---
import type { CollectionEntry } from 'astro:content';
import { getArticleUrl } from '../lib/site-routes';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
---

<div class="article-list-layout">
  <section aria-label="文章列表">
    {articles.length === 0 && (
      <p class="article-list-empty">暂时还没有已发布的文章。</p>
    )}
    {articles.length > 0 && articles.map(function (article) {
      return (
        <article class="article-list-item">
          <h2 class="article-list-title">
            <a href={getArticleUrl(article.data.permalink)}>{article.data.title}</a>
          </h2>
          <time class="article-date" datetime={article.data.date.toISOString()}>
            {article.data.date.toLocaleDateString('zh-CN')}
          </time>
        </article>
      );
    })}
  </section>

  {(Astro.slots.has('site-info') || Astro.slots.has('category-card')) && (
    <aside class="article-list-aside article-list-aside-left">
      <div class="article-list-cards">
        <slot name="site-info" />
        <slot name="category-card" />
      </div>
    </aside>
  )}

  {(Astro.slots.has('about-me') || Astro.slots.has('milestones')) && (
    <aside class="article-list-aside article-list-aside-right">
      <div class="article-list-cards">
        <slot name="about-me" />
        <slot name="milestones" />
      </div>
    </aside>
  )}
</div>

<style>
  .article-list-layout {
    display: grid;
    grid-template-areas: "left articles right";
    grid-template-columns: 14rem minmax(0, 43rem) 14rem;
    gap: 1.5rem;
    justify-content: center;
    align-items: start;
  }

  .article-list-layout [aria-label="文章列表"] {
    grid-area: articles;
    display: grid;
    align-content: start;
    min-width: 0;
    /* 10 个最小 4.75rem 的文章卡片，加上 9 个 0.625rem 的间距。 */
    min-height: 53.125rem;
    gap: 0.625rem;
  }

  .article-list-aside {
    position: relative;
    align-self: stretch;
    color: var(--text-secondary);
  }

  .article-list-aside-left {
    grid-area: left;
  }

  .article-list-aside-right {
    grid-area: right;
  }

  .article-list-cards {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 0;
  }

  .article-list-cards :global(.category-card),
  .article-list-cards :global(.milestones-card) {
    flex: 1 1 0;
    max-height: none;
    margin-top: 0;
  }

  .article-list-aside-placeholder {
    padding-top: 0.75rem;
  }

  .article-list-aside-title {
    display: block;
    margin-bottom: 0.8rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.15em;
  }

  .article-list-aside i {
    display: block;
    width: 100%;
    height: 0.45rem;
    margin-bottom: 0.55rem;
    background: var(--border-color);
    border-radius: 1rem;
    opacity: 0.7;
  }

  .article-list-aside i:nth-of-type(2) {
    width: 72%;
  }

  .article-list-aside i:nth-of-type(3) {
    width: 45%;
  }

  .article-list-item {
    position: relative;
    min-height: 4.75rem;
    padding: 1rem 1.25rem;
    background: var(--md-surface-container-lowest);
    border: 0;
    border-radius: 0.75rem;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 6%),
      0 4px 12px rgb(0 0 0 / 5%);
  }

  .article-list-item:hover {
    background: var(--md-surface-container-high);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 7%),
      0 7px 18px rgb(0 0 0 / 7%);
  }

  .article-list-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .article-list-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .article-list-title a::after {
    position: absolute;
    inset: 0;
    content: "";
    border-radius: 0.75rem;
    cursor: pointer;
  }

  .article-list-title a:hover {
    color: var(--accent-color);
    text-decoration: none;
  }

  .article-list-title a:focus-visible {
    outline: none;
  }

  .article-list-title a:focus-visible::after {
    outline: 2px solid var(--accent-color);
    outline-offset: 0.15rem;
  }

  .article-date {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-secondary);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.015em;
    white-space: nowrap;
  }

  .article-list-empty {
    margin: 0;
    padding: 3rem 1.5rem;
    color: var(--text-secondary);
    text-align: center;
    background: var(--surface-background);
    border: 1px solid var(--border-color);
    border-radius: 0.35rem;
    box-shadow: 0 0.35rem 1rem var(--shadow-color);
  }

  @media (max-width: 68rem) {
    .article-list-layout {
      grid-template-areas:
        "articles"
        "left"
        "right";
      grid-template-columns: minmax(0, 48rem);
      gap: 1rem;
    }

    .article-list-layout [aria-label="文章列表"] {
      min-height: 0;
      margin-bottom: 0.5rem;
    }

    .article-list-aside {
      width: 100%;
    }

    .article-list-aside:has(.article-list-cards:empty) {
      display: none;
    }

    .article-list-cards {
      position: static;
    }

    .article-list-cards :global(.category-card),
    .article-list-cards :global(.milestones-card) {
      flex: none;
    }
  }

  @media (max-width: 40rem) {
    .article-list-item {
      padding: 0.9rem 1rem;
      border-radius: 0.65rem;
    }

    .article-list-title a::after {
      border-radius: 0.65rem;
    }
  }
</style>
